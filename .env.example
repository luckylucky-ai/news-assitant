# ============================================
# 每日简报助手 - 环境变量配置
# 复制此文件为 .env 并填入你的真实配置
# ============================================

# --- 飞书 / Lark（必填） ---
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
# 飞书文档所在的文件夹 token（可选，不填则创建在根目录）
FEISHU_FOLDER_TOKEN=
# 指定群聊 chat_id（可选，不填则自动发送到机器人所在的所有群）
FEISHU_CHAT_ID=

# --- X / Twitter（MCP Server 需要） ---
X_API_KEY=your_api_key
X_API_SECRET_KEY=your_api_secret_key
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret

# --- Reddit（可选，不填也能用，匿名模式 10rpm） ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube（MCP Server 需要） ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- NewsAPI（可选） ---
NEWSAPI_KEY=your_newsapi_key

# --- 通用 ---
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
# 运行模式: schedule = 持续运行定时循环 / cron = 执行一次后退出
RUN_MODE=schedule
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
