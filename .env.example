# ============================================
# 每日简报助手 - 环境变量配置
# 复制此文件为 .env 并填入你的真实配置
# ============================================

# --- 飞书 / Lark ---
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
# 接收消息的用户 open_id（多个用逗号分隔）
FEISHU_RECEIVE_ID=ou_xxxxxxxxxxxx
# 接收消息的类型: open_id / user_id / email / chat_id
FEISHU_RECEIVE_ID_TYPE=open_id
# 飞书文档所在的文件夹 token（可选，不填则创建在根目录）
FEISHU_FOLDER_TOKEN=

# --- Reddit ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DailyDigestBot/1.0

# --- YouTube ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- X / Twitter ---
# 使用 RapidAPI 的 Twitter API 或官方 Bearer Token
X_BEARER_TOKEN=your_x_bearer_token

# --- NewsAPI ---
NEWSAPI_KEY=your_newsapi_key

# --- 通用 ---
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 时区
TIMEZONE=Asia/Shanghai
